# Copy this file to .env for local testing.
# On Render/Railway/Vercel, set these same values in the dashboard's Environment Variables section instead of using this file.

# Get this from https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key

# Optional: override which Claude model is used. Leave as-is unless Anthropic tells you this model is retired.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Get this from https://dashboard.stripe.com  (Developers -> API Keys). Use the SECRET key, not the publishable key.
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key

# Price in whole US dollars for a credit pack (each credit = one AI-generated contract/SOW).
CREDIT_PACK_PRICE_USD=12
CREDIT_PACK_CREDITS=15

# Monthly price in whole US dollars for the Invoice Builder + Receipt Generator subscription.
SUB_PRICE_USD=20

# How many free AI contract generations a visitor gets per day before being asked to buy credits.
# The invoice builder itself is always free and unlimited (it doesn't use the AI).
FREE_DAILY_GENERATIONS=1

# The full public URL this app will be deployed at (no trailing slash).
PUBLIC_URL=http://localhost:3001

PORT=3001
